generator client {
  provider = "prisma-client"
  output   = "../../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlockKind {
  CHART
  TEXT
}

enum SourceType {
  GOOGLE_SHEET
}

enum ChartTypeContent {
  BAR
  LINE
  PIE
  DONUT
}

enum ChartType {
  MULTIPLE
  SINGL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  
  dashboards  Dashboard[]
  dataSources DataSource[]
  charts      Chart[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Dashboard {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blocks    Block[]
  embedLink EmbedLink?
}

model Block {
  id          String    @id @default(cuid())
  dashboardId String
  x           Int
  y           Int
  w           Int
  h           Int
  kind        BlockKind
  chartId     String?
  text        String?

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  chart     Chart?    @relation(fields: [chartId], references: [id], onDelete: SetNull)
}

model Chart {
  id        String    @id @default(cuid())
  ownerId   String
  title     String
  options   Json?
  type      ChartType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blocks       Block[]
  chartContent ChartContent[]
}

model ChartContent {
  id          String           @id @default(cuid())
  datasetId   String?
  type        ChartTypeContent
  labelColumn String
  valueColumn String
  chartId     String
  dataset     Dataset?         @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  chart       Chart            @relation(fields: [chartId], references: [id], onDelete: Cascade)
}

model DataSource {
  id        String     @id @default(cuid())
  ownerId   String
  name      String
  type      SourceType
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  link      String

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  datasets Dataset[]
}

model Dataset {
  id                String  @id @default(cuid())
  sourceId          String
  name              String
  columnsIsFirstRow Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source        DataSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshot      DatasetSnapshot?
  chartContents ChartContent[]
}

model DatasetSnapshot {
  datasetId String @id
  columns   Json
  rows      Json
  rowCount  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model EmbedLink {
  id             String    @id @default(cuid())
  dashboardId    String    @unique
  tokenHash      String    @unique
  allowedOrigins String[]
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
}
