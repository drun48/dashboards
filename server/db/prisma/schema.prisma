// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  TEXT
  CHART
}

enum ChartType {
  Pie
  Donut
  Bar
  Line
}

enum CurveType {
  LINEAR
  MONOTONE
  STEP
}

enum TypeConnection {
  PostgreSQL
  GoogleSheet
}

model Dashboard {
  id     Int     @id @default(autoincrement())
  name   String
  userId Int
  blocks Block[]

  user User @relation(fields: [userId], references: [id])
}

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  password   String
  name       String?
  dashboards Dashboard[]
}

model Block {
  id          Int   @id @default(autoincrement())
  x           Float
  y           Float
  w           Float
  h           Float
  dashboardId Int

  dashboard     Dashboard      @relation(fields: [dashboardId], references: [id])
  contentBlocks ContentBlock[]
}

model ContentBlock {
  id          Int         @id @default(autoincrement())
  type        ContentType @default(TEXT)
  title       String?
  description String?
  settings    Json
  text        String?

  chart Chart[]
  block Block[]
}

model Chart {
  id      Int @id @default(autoincrement())
  chartId Int

  contentBlock ContentBlock[]
  chart        ChartView[]
}

model ChartView {
  id Int @id @default(autoincrement())

  type         ChartType
  dataSourceId Int?
  labelColumn  String
  valueColumn  String

  colorScheme String?
  showLegend  Boolean @default(true)
  showTooltip Boolean @default(true)

  innerRadius Float?

  dataSource  DataSet? @relation(fields: [dataSourceId], references: [id])
  chartConfig Chart[]
}

model DataSource {
  id         Int            @id @default(autoincrement())
  urlConnect String
  type       TypeConnection
  dataSource DataSet[]
}

model DataSet {
  id           Int @id @default(autoincrement())
  connectionId Int

  chart       ChartView[]
  dataContent DataContent[]

  connection DataSource @relation(fields: [connectionId], references: [id])
}

model DataContent {
  id            Int       @id @default(autoincrement())
  header        String
  idRow         Int
  value         String
  dataSourceId  Int       @unique
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())

  dataSource DataSet @relation(fields: [dataSourceId], references: [id])
}
