generator client {
  provider = "prisma-client"
  output   = "../../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlockKind {
  CHART
  TEXT
}

enum SourceType {
  GOOGLE_SHEET
}

enum ChartType {
  BAR
  LINE
  PIE
  DONUT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  dashboards  Dashboard[]
  dataSources DataSource[]
  charts      Chart[]
}

model Dashboard {
  id            String   @id @default(cuid())
  ownerId       String
  title         String
  gridColumns   Int      @default(48)
  layoutVersion Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blocks    Block[]
  embedLink EmbedLink?
}

model Block {
  id          String    @id @default(cuid())
  dashboardId String
  x           Int
  y           Int
  w           Int
  h           Int
  kind        BlockKind
  chartId     String?
  text        String?

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  chart     Chart?    @relation(fields: [chartId], references: [id], onDelete: SetNull)
}

model Chart {
  id          String      @id @default(cuid())
  ownerId     String
  datasetId   String?
  name        String
  type        ChartType
  labelColumn String
  valueColumn String
  options     Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  dataset Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  blocks  Block[]
}

model DataSource {
  id         String     @id @default(cuid())
  ownerId    String
  name       String
  type       SourceType
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  link       String

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  datasets Dataset[]

}

model Dataset {
  id       String @id @default(cuid())
  sourceId String
  name     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshAt DateTime?

  source   DataSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshot DatasetSnapshot?
  charts   Chart[]
}

model DatasetSnapshot {
  datasetId String   @id
  columns   Json
  rows      Json
  rowCount  Int
  fetchedAt DateTime

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model EmbedLink {
  id             String    @id @default(cuid())
  dashboardId    String    @unique
  tokenHash      String    @unique
  allowedOrigins String[]
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
}
